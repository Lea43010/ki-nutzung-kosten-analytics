# Vorlage für die Zugangsdaten. Diese Datei darf ins Repo.
# Kopiere sie nach ".env" und trage deine echten Werte ein.
# Die Datei ".env" wird von Git ignoriert und darf NIE hochgeladen werden.

SNOWFLAKE_ACCOUNT=ORGANISATION-ACCOUNT
SNOWFLAKE_USER=DEINBENUTZERNAME
SNOWFLAKE_PASSWORD=DEINPASSWORT
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=KI_NUTZUNG_WH
SNOWFLAKE_DATABASE=KI_NUTZUNG
SNOWFLAKE_SCHEMA=RAW